# Copy this file to `.env` and fill it in. `.env` is gitignored (and .claudeignored) - THIS file is
# the only one that gets committed, so it must never contain a real value.
#
# The repository is PUBLIC. Credentials in a commit, a log or a chat are burned credentials.

# fantacalcio.it account. Required by `ratings` (the authenticated Excel API: votes + listone) and
# therefore by `bootstrap`: without it there is no listone, no votes and no registry.
FANTACALCIO_USERNAME=your-email@example.com
FANTACALCIO_PASSWORD=your-password

# Optional. User-Agent sent to fantacalcio.it's editorial pages (fc_site). The default is
# "FantAssistant/0.1 (+personal-use)" - identify yourself, do not pretend to be a browser.
# EUROLEGHE_USER_AGENT=FantAssistant/0.1 (+personal-use)

# Optional. Move the data folder or the database somewhere else (e.g. a bigger disk).
# The defaults are <repo>/data and <repo>/data/euroleghe.db.
# EUROLEGHE_DATA_DIR=D:\FantAssistant-data
# EUROLEGHE_DB_PATH=D:\FantAssistant-data\euroleghe.db
