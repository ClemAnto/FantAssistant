<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only to know whether to open the webapp from its last copy (no network) or from the site. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- The app opens on the webapp, in a WebView with the bridge to Leghe (14/10/2026). It keeps the launcher's
             component name, so an icon already on the home keeps working. `configChanges`: a rotation must not
             recreate the WebView, because the league tokens live in its sessionStorage. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- «Widget» on the icon's long-press menu: the widget's screen without going through the widget. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- The widget's screen: where it reads from, a button to refresh it now, the webapp's address. -->
        <activity
            android:name=".WidgetActivity"
            android:exported="false"
            android:label="@string/widget_screen" />

        <!-- A row's tap goes through here to SofaScore (see OpenActivity). Invisible and not in recents. -->
        <activity
            android:name=".OpenActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name=".MatchesWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/matches_widget_info" />
        </receiver>

        <!-- The list inside the widget: a ListView fed by this service, the only scrolling list a widget may hold. -->
        <service
            android:name=".MatchesListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- The crests for the list's rows, by URI instead of as bitmaps (see CrestProvider). Exported because the
             launcher reads them; read-only, and only club badges. -->
        <provider
            android:name=".CrestProvider"
            android:authorities="it.fantassistant.widget.crests"
            android:exported="true" />
    </application>
</manifest>
