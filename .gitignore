# --- Segreti: MAI committare ---
.env
.env.*
!.env.example

# --- Dati: fonte di verità su Drive, DB ricostruibile ---
/data/*.db
# SQLite writes these beside the DB while a transaction is open; a background ingest run had one
# tracked by an unrelated `git add -A`. They are transient database PAGES, never source.
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm
/data/*.sqlite
/data/raw/*
!/data/raw/.gitkeep
/data/inbox/*
!/data/inbox/.gitkeep
/data/cache/
# The app's data bundle: a pruned copy of the DB, so it carries the same paid fantacalcio.it content
# the cache does ("NON PUO' ESSERE RIPRODOTTO NE' PUBBLICATO"). The repo is PUBLIC - it ships with
# the app, never through git.
/data/export/
# I pacchetti del viaggio nel tempo: sono FOGLI, cioe' la stessa roba dell'export - nomi, prezzi e voti
# del contenuto a pagamento - e si rigenerano con `timepack --all`. Viaggiano nel bundle, come tutto il
# resto, e il bundle passa da git solo sul branch `gh-pages`.
/data/timepacks/
# report/modelli rigenerati dal toolkit (coverage, calibrazione voto sintetico)
/data/reports/
# I dati di lavoro del banco del draft: nomi, prezzi e voti del contenuto a pagamento, e si RIGENERANO
# (`toolkit/bench/draft/extract.py`, due minuti) invece di essere conservati. `appcode.mjs` e' il bundle
# del codice dell'app: un artefatto di build, mai una copia da committare.
/toolkit/bench/draft/*.json
/toolkit/bench/draft/appcode.mjs
# ...E LA STESSA ROBA SCRITTA FUORI DA `data/`, che e' il buco trovato il 25/08/2026: ogni riga qui
# sopra e' ancorata a `/data/`, quindi un `bundle.sqlite` finito nella RADICE del repository non era
# ignorato da niente - e ce n'era uno (0 byte, 20/08). Su un repository PUBBLICO che porta contenuto a
# pagamento, un `git add -A` e' tutto quello che serve. Nessun .sqlite e nessun .db e' tracciato oggi
# (misurato: `git ls-files '*.sqlite' '*.db'` = 0), quindi la regola non nasconde niente di legittimo.
*.sqlite
*.db

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Node / app ---
node_modules/
/app/dist/
/app/out/
/app/.angular/
# ...e la stessa cache quando `ng` gira con la RADICE come cwd (succede guidando gli arnesi e2e da qui):
# la regola sopra è ancorata a `/app/`, e un'ignore vale solo quanto la sua ancora - lezione del 25/08.
/.angular/

# --- OS / editor ---
.DS_Store
Thumbs.db
*.log
